[sub_resource type="GDScript" id="GDScript_vis"]
script/source = "extends Node2D
func _draw() -> void:
	var target = get_parent()
	var w: float = 140.0
	var h: float = 160.0
	if target and \"platform_size\" in target:
		w = target.platform_size.x
		h = target.platform_size.y
	var is_winter := false
	var gm = get_node_or_null(\"/root/GameManager\")
	if gm and gm.has_method(\"is_winter_theme\"):
		is_winter = gm.is_winter_theme()
	var rect := Rect2(0, 0, w, h)
	var base_col := Color(\"#0c111c\") if is_winter else Color(\"#0a0b10\")
	draw_rect(rect, base_col, true)
	if is_winter:
		var snow_h := 5.5
		draw_rect(Rect2(0, 0, w, snow_h), Color(\"#f1f5f9\"), true)
		draw_rect(Rect2(0, 0, w, 2.0), Color(\"#ffffff\"), true)
		draw_rect(Rect2(0, snow_h - 1.5, w, 1.5), Color(\"#94a3b8\"), true)
	else:
		draw_rect(Rect2(0, 0, w, 2.0), Color(\"#262e3e\"), true)
"

