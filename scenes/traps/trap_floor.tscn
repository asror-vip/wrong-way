[sub_resource type="GDScript" id="GDScript_vis"]
script/source = "extends Node2D
func _draw() -> void:
	var target = get_parent()
	var w: float = 140.0
	var h: float = 160.0
	if target and \"platform_size\" in target:
		w = target.platform_size.x
		h = target.platform_size.y
	var is_winter := false
	var gm = get_node_or_null(\"/root/GameManager\")
	if gm and gm.has_method(\"is_winter_theme\"):
		is_winter = gm.is_winter_theme()
	var rect := Rect2(0, 0, w, h)
	var base_col := Color(\"#0d131f\") if is_winter else Color(\"#1c1a22\")
	draw_rect(rect, base_col, true)
	if is_winter:
		var snow_h := 5.5
		if w > 36.0:
			draw_rect(Rect2(Vector2.ZERO, Vector2(w, snow_h)), Color(\"#f1f5f9\"), true)
			draw_rect(Rect2(Vector2.ZERO, Vector2(w, 2.0)), Color(\"#ffffff\"), true)
			draw_rect(Rect2(Vector2(0, snow_h - 1.5), Vector2(w, 1.5)), Color(\"#94a3b8\"), true)
			var icicle_step := 32.0
			var num_icicles := int((w - 20.0) / icicle_step)
			for i in range(num_icicles):
				var ix := 14.0 + float(i) * icicle_step
				var ilen := 4.0 if (i % 2 == 0) else 6.0
				draw_colored_polygon(PackedVector2Array([
					Vector2(ix - 2.0, snow_h),
					Vector2(ix + 2.0, snow_h),
					Vector2(ix, snow_h + ilen)
				]), Color(\"#bae6fd\"))
		else:
			draw_rect(Rect2(Vector2.ZERO, Vector2(2.5, h)), Color(0.49, 0.86, 0.99, 0.6), true)
	else:
		draw_rect(Rect2(Vector2.ZERO, Vector2(w, 3.0)), Color(\"#342f3a\"), true)
"

