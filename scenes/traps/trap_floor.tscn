[gd_scene load_steps=5 format=3 uid="uid://trapfloor01"]

[ext_resource type="Script" path="res://scripts/traps/trap_floor.gd" id="1_tf"]

[sub_resource type="RectangleShape2D" id="RectangleShape2D_tf1"]
